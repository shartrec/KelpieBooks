  "query": "UPDATE items SET\n                 code = $1,\n                 name = $2,\n                 description = $3,\n                 item_type = $4::item_type,\n                 uom_id = $5,\n                 unit_price = $6,\n                 purchase_unit_cost = $7,\n                 income_account_id = $8,\n                 tax_category_id = $9,\n                 is_active = $10\n             WHERE id = $11 AND organization_id = $12 RETURNING\n                id,\n                organization_id as org_id,\n                code,\n                name,\n                description,\n                item_type AS \"item_type: ItemType\",\n                uom_id,\n                unit_price,\n                purchase_unit_cost as unit_cost,\n                income_account_id,\n                tax_category_id as \"tax_category_id: TaxCategoryId\",\n                is_active,\n                created_at\n           ",
