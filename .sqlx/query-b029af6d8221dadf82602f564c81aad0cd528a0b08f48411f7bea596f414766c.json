{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            je.id,\n            je.transaction_id,\n            je.account_id,\n            a.name as account_name,\n            je.debit,\n            je.credit,\n            je.description,\n            je.created_at\n        FROM journal_entries je\n        JOIN accounts a ON je.account_id = a.id\n        WHERE je.transaction_id = $1\n        ORDER BY je.debit DESC, je.credit\n        ",
